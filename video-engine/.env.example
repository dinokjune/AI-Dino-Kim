# 이 파일을 .env 로 복사하고 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# play.cartesia.ai → My Voices → 내 클론 목소리의 ID
CARTESIA_VOICE_ID=

# 선택
# CLAUDE_MODEL=claude-opus-5-5
# CARTESIA_MODEL=sonic-3
# CARTESIA_VERSION=2024-11-13
# PORT=8787

# MP4 렌더에 쓰는 ffmpeg 경로 (PATH 에 있으면 비워 둠)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# 예약 실행(CLI) 비용 표시용: Cartesia 1,000크레딧당 달러, 원/달러 환율 (스튜디오는 ⚙ 설정에서 지정)
# CARTESIA_USD_PER_1K=0.05
# KRW_RATE=1400

# 내 글꼴을 찾을 폴더 (기본: 다운로드 폴더 + video-engine/fonts). 여러 개는 윈도우 ; 맥 : 로 구분
# FONTS_DIR=C:\Users\나\Downloads;D:\글꼴

# 유튜브 비공개 업로드 (선택) – README "유튜브 업로드 준비" 참고
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=   ← node youtube.mjs auth 가 채워 줍니다

# 완성·실패 알림 웹훅 (선택, 슬랙·디스코드 등) – {text, content, job} JSON 을 POST
# NOTIFY_WEBHOOK_URL=
