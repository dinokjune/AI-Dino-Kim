# 이 파일을 .env 로 복사하고 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 대본을 쓸 AI: 비워 두면 설치된 구독 CLI(claude-cli → codex → gemini 순)를 쓰고, 하나도 없을 때만 claude-api(종량제)
# 하나로 고정하려면: claude-cli | codex | gemini | claude-api
# LLM_ENGINE=codex
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# play.cartesia.ai → My Voices → 내 클론 목소리의 ID
CARTESIA_VOICE_ID=

# 경제음성 (내 PC 로컬 Qwen3-TTS 클론, economic-voice 스킬): myvoice.cmd 가 있으면 자동으로 기본 목소리가 됩니다
# MYVOICE_CMD=D:/Claude/Projects/my-voice-clone/myvoice.cmd
# MYVOICE_VOICE=kkwabaegi
# MYVOICE_TIMEOUT_MIN=240     (한 번에 만드는 최대 시간, 분)

# 다른 TTS (쓰는 것만 넣으면 됩니다)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=            (TTS 전용으로 씁니다. 대본은 Claude가 씁니다)
# OPENAI_TTS_VOICE=alloy
# GOOGLE_TTS_API_KEY=        (비워 두면 gcloud CLI 로그인을 씁니다: gcloud auth login)
# GOOGLE_CLOUD_PROJECT=      (gcloud 로그인일 때 요금·할당량 프로젝트, 비우면 gcloud config 의 프로젝트)
# GOOGLE_TTS_VOICE=ko-KR-Neural2-A
# CLOVA_CLIENT_ID=
# CLOVA_CLIENT_SECRET=
# CLOVA_SPEAKER=nara
# 설치된 글꼴을 목록에 넣지 않으려면
# SYSTEM_FONTS=0

# 선택
# CLAUDE_MODEL=claude-opus-5-5
# CARTESIA_MODEL=sonic-3
# CARTESIA_VERSION=2024-11-13
# PORT=8787

# MP4 렌더에 쓰는 ffmpeg 경로 (PATH 에 있으면 비워 둠)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# 예약 실행(CLI) 비용 표시용: Cartesia 1,000크레딧당 달러, 원/달러 환율 (스튜디오는 ⚙ 설정에서 지정)
# CARTESIA_USD_PER_1K=0.05
# ELEVENLABS_USD_PER_1K=0.22
# OPENAI_USD_PER_1K=0.015
# GOOGLE_USD_PER_1K=0.016
# CLOVA_USD_PER_1K=
# KRW_RATE=1400

# 내 글꼴을 찾을 폴더 (기본: 다운로드 폴더 + video-engine/fonts). 여러 개는 윈도우 ; 맥 : 로 구분
# FONTS_DIR=C:\Users\나\Downloads;D:\글꼴

# 유튜브 비공개 업로드 (선택) – README "유튜브 업로드 준비" 참고
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=   ← node youtube.mjs auth 가 채워 줍니다

# 완성·실패 알림 웹훅 (선택, 슬랙·디스코드 등) – {text, content, job} JSON 을 POST
# NOTIFY_WEBHOOK_URL=
